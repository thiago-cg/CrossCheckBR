# Copie para .env e ajuste se necessário
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
# Deixe vazio para autodetectar via GET /v1/models; ou fixe o nome servido pelo Unsloth:
UNSLOTH_MODEL_NAME=
UNSLOTH_API_KEY=not-needed
# Classificador laya (usado com --classifier laya)
LAYA_THRESHOLD=0.80
# auto | english | multilingual | typed-decisions
LAYA_MODEL=auto
# vazio = auto (cuda se disponível, senão cpu)
LAYA_DEVICE=
