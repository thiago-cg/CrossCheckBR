# Telegram (obrigatório p/ o bot; API funciona sem)
TELEGRAM_TOKEN=
# SerpAPI (opcional; sem ela, só índice local)
# engine: google (orgânico, padrão) ou google_news (legado)
# estrategia: agente (padrão), simples, avancada ou ambas
# Legado news-only: SERP_ENGINE=google_news + SERP_ESTRATEGIA=simples
# (estrategia=agente orquestra os motores e ignora SERP_ENGINE).
SERPAPI_KEY=
SERP_ENGINE=google
# estrategia (orgânico): agente (padrão), simples, avancada ou ambas
SERP_ESTRATEGIA=agente
# teto global de buscas do agente por /checar
AGENTE_MAX_BUSCAS=8
# hosts extras de checagem além dos 13 do padrão (vírgula)
SERP_SITES_EXTRAS=
# LLM local OpenAI-compatível (Unsloth/vLLM; só p/ afirmações e padrões)
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_MODEL_NAME=
UNSLOTH_API_KEY=not-needed
# laya (classificação e implicação; default já calibrado)
LAYA_THRESHOLD=0.80
LAYA_MODEL=auto
# Pipeline
RELEVANCIA_MIN=0.30
MAX_AFIRMACOES=3
MAX_EVIDENCIAS=5
CACHE_SERPAPI_TTL=3600
# Modelo próprio fake-news (vazio = mock explícito)
FAKE_MODEL_PATH=
